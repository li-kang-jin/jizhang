# 默认统一使用 LF，避免跨平台协作产生整文件 diff 噪音
* text=auto eol=lf

# Windows 脚本保留 CRLF，否则可能无法执行
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary

# 锁文件不计入语言统计
package-lock.json linguist-generated=true
pnpm-lock.yaml linguist-generated=true
