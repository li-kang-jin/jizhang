# 生产环境变量模板。
#
# ⚠️ 不要把这个文件改名成 .env 提交到仓库。
# 服务器上由 deploy/prod/provision.sh 自动生成 /opt/jizhang/.env 并写入随机强密钥，
# 这个文件只用来告诉你「需要哪些变量」。
#
# 注意：这个文件同时被 systemd（EnvironmentFile=）和 docker compose（同目录 .env）读取，
# 所以必须是纯净的 KEY=value 格式 —— 不能写 export，值里也不要带 # 。

# ---------- PostgreSQL ----------
POSTGRES_DB=jizhang
POSTGRES_USER=jizhang
# 由 provision.sh 用 openssl rand -hex 16 生成
POSTGRES_PASSWORD=CHANGE_ME

# ---------- 后端连接（systemd EnvironmentFile 读取） ----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jizhang
DB_USER=jizhang
DB_PASSWORD=CHANGE_ME

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------- JWT ----------
# 长度必须 >= 32 字节；本工程当前用 HS256，密钥泄露等于所有人可伪造登录态
JIZHANG_JWT_SECRET=CHANGE_ME
